# Copie para .env e preencha. O .env nunca vai para o repositório.
# Usado pelo docker-compose.prod.yml.

# --- Obrigatório -------------------------------------------------------------
# Domínio público; o DNS tem de apontar para este servidor.
DOMAIN=financas.exemplo.pt
# Assina as sessões. Gere com:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Palavra-passe da base de dados (nunca a de exemplo).
POSTGRES_PASSWORD=
POSTGRES_USER=financeuser
POSTGRES_DB=financedb

# --- Email (recomendado) -----------------------------------------------------
# Convites e recuperação de palavra-passe. Sem SMTP, os convites devolvem o
# link para enviar à mão, mas a recuperação de palavra-passe não funciona.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Finance AI <nao-responder@exemplo.pt>"

# --- Documentos: Cloudflare R2 (recomendado) --------------------------------
# Sem isto as faturas ficam no disco do servidor (volume "uploads").
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=finance-ai-documents
R2_JURISDICTION=eu

# --- Cópia de segurança fora do servidor (recomendado) ----------------------
# Bucket S3-compatível (o Cloudflare R2 serve). Vazio = só cópia local.
BACKUP_S3_BUCKET=
# Ex.: https://<conta>.r2.cloudflarestorage.com
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PREFIX=finance-ai
BACKUP_S3_REGION=auto
# Apaga no bucket as cópias com mais de N dias (vazio = nunca apaga).
BACKUP_S3_KEEP_DAYS=90
# Cifra a cópia externa (gpg AES256). Guarde esta frase FORA do servidor:
# sem ela não há restauro. Ver deploy/RESTORE.md.
BACKUP_ENCRYPTION_PASSPHRASE=

# --- Assistente com IA (opcional) ---------------------------------------------
# Chave da Anthropic (console.anthropic.com). Vazio = modo básico, sem custo.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ASSISTANT_ENABLED=1
# Tecto de custo: pedidos por utilizador em cada janela de tempo.
ASSISTANT_RATE_LIMIT=20
ASSISTANT_RATE_WINDOW_SECONDS=600

# --- Monitorização de erros (opcional) --------------------------------------
# DSN de um projeto Sentry (sentry.io). Vazio = desligada.
SENTRY_DSN=
# Fração de pedidos medidos para desempenho (0 a 1).
SENTRY_TRACES_SAMPLE_RATE=0

# --- Webhooks de email/WhatsApp (opcional; fechados enquanto vazio) ---------
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# --- Afinações (os valores por omissão servem) ------------------------------
WEB_CONCURRENCY=4
SCHEDULER_INTERVAL_HOURS=6
BACKUP_KEEP_DAYS=14
LOG_LEVEL=INFO
