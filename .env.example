# Copie para .env e preencha. O .env nunca vai para o repositório.
# Usado pelo docker-compose.prod.yml.

# --- Obrigatório -------------------------------------------------------------
# Domínio público; o DNS tem de apontar para este servidor.
DOMAIN=financas.exemplo.pt
# Assina as sessões. Gere com:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Palavra-passe da base de dados (nunca a de exemplo).
POSTGRES_PASSWORD=
POSTGRES_USER=financeuser
POSTGRES_DB=financedb

# --- Documentos: Cloudflare R2 (recomendado) ------------------------------------
# Sem isto as faturas ficam no disco do servidor (volume "uploads").
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=finance-ai-documents
R2_JURISDICTION=eu

# --- Email dos convites (opcional) ------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Finance AI <convites@exemplo.pt>"

# --- Webhooks de email/WhatsApp (opcional; fechados enquanto vazio) ---------
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# --- Afinações (os valores por omissão servem) ------------------------------
WEB_CONCURRENCY=4
SCHEDULER_INTERVAL_HOURS=6
BACKUP_KEEP_DAYS=14
LOG_LEVEL=INFO
